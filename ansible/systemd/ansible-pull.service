[Unit]
Description=Run ansible-pull to update configuration
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/ansible
ExecStart=/usr/local/bin/ansible-pull -d /opt/ansible -U https://github.com/AristideWafo/gitops-ansible-pull.git -C prod -i localhost, ansible/playbooks/site.yml

[Install]
WantedBy=multi-user.target